# Copy this file to .env.local when integrating with the real backend.
# Do not commit .env.local.

# true = use real backend APIs, false = use frontend mock data
VITE_API_ENABLED=true

# Leave empty when using the Vite /api proxy locally.
# On Render, set this to the deployed backend URL, for example:
# VITE_API_BASE_URL=https://scms-backend.onrender.com
VITE_API_BASE_URL=

# Local Spring Boot backend used by the Vite proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
